{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crutkas/build-extra/arm64-validation/bundle-lock-v1.schema.json",
  "title": "ARM64 bundle lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "status",
        "resolution",
        "release",
        "asset",
        "package",
        "overlay"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "role": {
          "enum": ["base-bundle", "package", "runtime", "tool"]
        },
        "status": {
          "enum": ["resolved", "unresolved"]
        },
        "resolution": {
          "type": ["string", "null"]
        },
        "release": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "tag", "targetCommit"],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^crutkas/[^/]+$"
                },
                "tag": { "type": "string", "minLength": 1 },
                "targetCommit": { "$ref": "#/$defs/commit" }
              }
            }
          ]
        },
        "asset": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "name", "bytes", "sha256"],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://github\\.com/crutkas/"
                },
                "name": { "type": "string", "minLength": 1 },
                "bytes": { "type": "integer", "minimum": 1 },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "package": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "personality", "provides"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "personality": {
                  "enum": ["mixed", "mingw", "msys", "managed", "windows"]
                },
                "provides": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "overlay": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "destination", "include", "exclude"],
              "properties": {
                "enabled": { "type": "boolean" },
                "destination": { "type": "string" },
                "include": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "exclude": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unresolved" } }
          },
          "then": {
            "properties": {
              "resolution": { "type": "null" },
              "release": { "type": "null" },
              "asset": { "type": "null" },
              "package": { "type": "null" },
              "overlay": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "resolution": { "type": "string", "minLength": 1 },
              "release": { "type": "object" },
              "asset": { "type": "object" },
              "package": { "type": "object" },
              "overlay": { "type": "object" }
            }
          }
        }
      ]
    }
  }
}
