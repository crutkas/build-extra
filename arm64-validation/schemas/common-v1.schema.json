{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crutkas/build-extra/arm64-validation/schemas/common-v1.schema.json",
  "title": "ARM64 bundle validator common v1 definitions",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!preview-evidence(?:/|$))[^:]+$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "targetCommit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(crutkas/[A-Za-z0-9_.-]+|git-for-windows/git|ip7z/7zip)$"
        },
        "rawCommit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "targetCommit",
            "sourcePath"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^(crutkas/[A-Za-z0-9_.-]+|git-for-windows/git|ip7z/7zip)$"
            },
            "targetCommit": {
              "$ref": "#/$defs/commit"
            },
            "sourcePath": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "targetCommit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "name",
        "bytes",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(github\\.com|raw\\.githubusercontent\\.com)/"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "personality",
        "provides"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "personality": {
          "enum": [
            "msys",
            "mingw",
            "managed",
            "mixed",
            "tool"
          ]
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    }
  }
}
