{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crutkas/build-extra/arm64-validation/schemas/runtime-evidence-v1.schema.json",
  "title": "ARM64 runtime evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "previewId",
    "admissionMode",
    "sourceLockSha256",
    "lockSha256",
    "provenanceSha256",
    "payloadManifestSha256",
    "rootInventorySha256",
    "staticReportSha256",
    "validator",
    "host",
    "collector",
    "collectedUtc",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "previewId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
    },
    "admissionMode": {
      "enum": [
        "Preview",
        "Final"
      ]
    },
    "sourceLockSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "lockSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "provenanceSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "payloadManifestSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "rootInventorySha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "staticReportSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "bytes",
        "sha256",
        "mode"
      ],
      "properties": {
        "repository": {
          "const": "crutkas/build-extra"
        },
        "commit": {
          "$ref": "common-v1.schema.json#/$defs/commit"
        },
        "path": {
          "const": "validate-arm64-bundle.ps1"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        },
        "mode": {
          "const": "Runtime"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "const": "Windows"
        },
        "architecture": {
          "const": "ARM64"
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputId",
        "repository",
        "commit",
        "sourcePath",
        "url",
        "bytes",
        "sha256",
        "method"
      ],
      "properties": {
        "inputId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "repository": {
          "type": "string",
          "pattern": "^crutkas/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "$ref": "common-v1.schema.json#/$defs/commit"
        },
        "sourcePath": {
          "$ref": "common-v1.schema.json#/$defs/relativePath"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://raw\\.githubusercontent\\.com/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        },
        "method": {
          "const": "ETW-Kernel-Process-ImageLoad"
        }
      }
    },
    "collectedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason",
        "command",
        "behavior",
        "trace"
      ],
      "properties": {
        "id": {
          "enum": [
            "Git Bash",
            "Git",
            "SSH",
            "GPG",
            "hook",
            "submodule",
            "rebase",
            "git-svn"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "unresolved"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "behavior": {
          "oneOf": [
            {
              "$ref": "#/$defs/behavior"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace": {
          "oneOf": [
            {
              "$ref": "#/$defs/trace"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "Git Bash"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/$defs/gitBashCommand"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "Git"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/$defs/gitCommand"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "SSH"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/$defs/sshCommand"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "GPG"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/$defs/gpgCommand"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "hook"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/$defs/hookCommand"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "submodule"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/$defs/submoduleCommand"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "rebase"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/$defs/rebaseCommand"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "git-svn"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "$ref": "#/$defs/gitSvnCommand"
              }
            }
          }
        }
      ]
    },
    "gitBashCommand": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\.*\\\\usr\\\\bin\\\\bash\\.exe$"
        },
        {
          "const": "--noprofile"
        },
        {
          "const": "--norc"
        },
        {
          "const": "-lc"
        },
        {
          "const": "exit 0"
        }
      ],
      "items": false
    },
    "gitCommand": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\.*\\\\bin\\\\git\\.exe$"
        },
        {
          "const": "--version"
        }
      ],
      "items": false
    },
    "sshCommand": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\.*\\\\usr\\\\bin\\\\ssh\\.exe$"
        },
        {
          "const": "-V"
        }
      ],
      "items": false
    },
    "gpgCommand": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\.*\\\\usr\\\\bin\\\\gpg\\.exe$"
        },
        {
          "const": "--version"
        }
      ],
      "items": false
    },
    "hookCommand": {
      "$ref": "#/$defs/gitBashCommand"
    },
    "submoduleCommand": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\.*\\\\bin\\\\git\\.exe$"
        },
        {
          "const": "submodule"
        },
        {
          "const": "status"
        },
        {
          "const": "--recursive"
        }
      ],
      "items": false
    },
    "rebaseCommand": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\.*\\\\usr\\\\bin\\\\bash\\.exe$"
        },
        {
          "const": "--noprofile"
        },
        {
          "const": "--norc"
        },
        {
          "const": "-lc"
        },
        {
          "const": "git rebase --show-current-patch"
        }
      ],
      "items": false
    },
    "gitSvnCommand": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\.*\\\\usr\\\\bin\\\\bash\\.exe$"
        },
        {
          "const": "--noprofile"
        },
        {
          "const": "--norc"
        },
        {
          "const": "-lc"
        },
        {
          "const": "git svn --version"
        }
      ],
      "items": false
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "passed",
        "exitCode"
      ],
      "properties": {
        "operation": {
          "enum": [
            "git-bash-startup",
            "git-command",
            "ssh-command",
            "gpg-command",
            "git-hook",
            "git-submodule",
            "git-rebase",
            "git-svn"
          ]
        },
        "passed": {
          "const": true
        },
        "exitCode": {
          "const": 0
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "processEventsComplete",
        "imageLoadEventsComplete",
        "processTreeComplete",
        "lostEvents",
        "startUtc",
        "endUtc",
        "processes"
      ],
      "properties": {
        "complete": {
          "const": true
        },
        "processEventsComplete": {
          "const": true
        },
        "imageLoadEventsComplete": {
          "const": true
        },
        "processTreeComplete": {
          "const": true
        },
        "lostEvents": {
          "const": 0
        },
        "startUtc": {
          "type": "string",
          "format": "date-time"
        },
        "endUtc": {
          "type": "string",
          "format": "date-time"
        },
        "processes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/process"
          }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "parentInstanceId",
        "processId",
        "startUtc",
        "endUtc",
        "role",
        "path",
        "sha256",
        "architecture",
        "personality",
        "modulesComplete",
        "modules"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "parentInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "processId": {
          "type": "integer",
          "minimum": 1
        },
        "startUtc": {
          "type": "string",
          "format": "date-time"
        },
        "endUtc": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "enum": [
            "role",
            "support"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\"
        },
        "sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        },
        "architecture": {
          "enum": [
            "arm64",
            "arm64ec",
            "anycpu",
            "x64",
            "x86",
            "unknown"
          ]
        },
        "personality": {
          "enum": [
            "msys",
            "mingw",
            "managed",
            "cygwin"
          ]
        },
        "modulesComplete": {
          "type": "boolean"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "architecture",
        "personality"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\"
        },
        "sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        },
        "architecture": {
          "enum": [
            "arm64",
            "arm64ec",
            "anycpu",
            "x64",
            "x86",
            "unknown"
          ]
        },
        "personality": {
          "enum": [
            "msys",
            "mingw",
            "managed",
            "cygwin"
          ]
        }
      }
    }
  }
}
