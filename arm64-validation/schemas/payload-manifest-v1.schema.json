{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crutkas/build-extra/arm64-validation/schemas/payload-manifest-v1.schema.json",
  "title": "ARM64 payload manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockSha256",
    "provenanceSha256",
    "scope",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "lockSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "provenanceSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "excludedPrefixes"
      ],
      "properties": {
        "root": {
          "const": "."
        },
        "excludedPrefixes": {
          "const": [
            "preview-evidence/"
          ]
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "bytes",
        "sha256",
        "architecture",
        "machine",
        "personality",
        "imports",
        "clrFlags",
        "linkTarget"
      ],
      "properties": {
        "path": {
          "$ref": "common-v1.schema.json#/$defs/relativePath"
        },
        "type": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "hardlink"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "architecture": {
          "enum": [
            null,
            "non-pe",
            "arm64",
            "x64",
            "x86",
            "anycpu",
            "arm64ec",
            "unknown"
          ]
        },
        "machine": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9A-F]{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "personality": {
          "enum": [
            null,
            "none",
            "msys",
            "cygwin",
            "mingw",
            "managed"
          ]
        },
        "imports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "clrFlags": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "linkTarget": {
          "oneOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
