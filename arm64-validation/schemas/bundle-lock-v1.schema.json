{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crutkas/build-extra/arm64-validation/schemas/bundle-lock-v1.schema.json",
  "title": "ARM64 bundle lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceLock",
    "sourceDateEpoch",
    "nativeShellClosure",
    "inputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "preview-evidence/source-lock.json"
        },
        "sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "nativeShellClosure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common-v1.schema.json#/$defs/relativePath"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    }
  },
  "$defs": {
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "destination",
        "include",
        "exclude",
        "mappings"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mappings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceMember",
              "destinationPath"
            ],
            "properties": {
              "sourceMember": {
                "$ref": "common-v1.schema.json#/$defs/relativePath"
              },
              "destinationPath": {
                "$ref": "common-v1.schema.json#/$defs/relativePath"
              }
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "status",
        "resolution",
        "release",
        "asset",
        "package",
        "overlay"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "role": {
          "enum": [
            "base-bundle",
            "payload",
            "validation-tool"
          ]
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        },
        "resolution": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "github-release",
                    "github-raw-commit"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "release": {
          "oneOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/release"
            },
            {
              "$ref": "common-v1.schema.json#/$defs/rawCommit"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset": {
          "oneOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "package": {
          "oneOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/package"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlay": {
          "oneOf": [
            {
              "$ref": "#/$defs/overlay"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "resolution": {
                "type": "null"
              },
              "release": {
                "type": "null"
              },
              "asset": {
                "type": "null"
              },
              "package": {
                "type": "null"
              },
              "overlay": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "resolution": {
                "type": "object"
              },
              "release": {
                "type": "object"
              },
              "asset": {
                "type": "object"
              },
              "package": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "overlay": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
