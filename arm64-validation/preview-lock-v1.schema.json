{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crutkas/build-extra/arm64-validation/preview-lock-v1.schema.json",
  "title": "Git for Windows ARM64 preview lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "previewId", "nativeShellClosure", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "git-for-windows/arm64-preview-lock" },
    "previewId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "nativeShellClosure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slot", "resolved"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "slot": { "type": "string", "minLength": 1 },
          "resolved": { "type": "boolean" },
          "version": { "type": ["string", "null"] },
          "archive": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?/)(?!.*//)(?!.*\\\\).+[^/]$"
    }
  }
}
