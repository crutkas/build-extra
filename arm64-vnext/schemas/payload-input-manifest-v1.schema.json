{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitforwindows.org/schemas/arm64-vnext-payload-input-manifest-v1.json",
  "title": "ARM64 vNext payload input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "epoch",
    "candidate",
    "authority",
    "payload_files"
  ],
  "properties": {
    "schema": {
      "const": "arm64-vnext-payload-input-manifest-v1"
    },
    "epoch": {
      "const": "2026-08-31-v1"
    },
    "candidate": {
      "$ref": "#/$defs/source"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_provenance"
      ],
      "properties": {
        "input_provenance": {
          "$ref": "#/$defs/sealedIdentity"
        }
      }
    },
    "payload_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/payloadFile"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sealedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_sha256",
        "payload_sha256"
      ],
      "properties": {
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "recordReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "tree": {
          "$ref": "#/$defs/gitObject"
        }
      }
    },
    "payloadFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256",
        "source",
        "archive",
        "build_recipe",
        "windows_image",
        "provenance_records"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provenance_id",
            "url",
            "size",
            "sha256",
            "signature"
          ],
          "properties": {
            "provenance_id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "signature": {
              "type": [
                "object",
                "string"
              ]
            }
          }
        },
        "build_recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "windows_image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provenance_id",
            "sha256"
          ],
          "properties": {
            "provenance_id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "provenance_records": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/recordReference"
          }
        }
      }
    }
  }
}
